---
interface Props {
  title?: string;
}

const { title = "BOOM Stack" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- HTMX for dynamic HTML interactions -->
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>

    <!-- Basic styling -->
    <style>
      :root {
        --color-bg: #ffffff;
        --color-text: #1a1a1a;
        --color-border: #e5e5e5;
        --color-accent: #3b82f6;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
                     'Helvetica Neue', Arial, sans-serif;
        line-height: 1.6;
        color: var(--color-text);
        background: var(--color-bg);
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
      }

      h1, h2, h3 {
        margin-bottom: 1rem;
      }

      p {
        margin-bottom: 1rem;
      }

      button {
        background: var(--color-accent);
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 0.25rem;
        cursor: pointer;
        font-size: 1rem;
      }

      button:hover {
        opacity: 0.9;
      }

      hr {
        margin: 2rem 0;
        border: none;
        border-top: 1px solid var(--color-border);
      }

      code {
        background: #f3f4f6;
        padding: 0.125rem 0.25rem;
        border-radius: 0.25rem;
        font-family: 'Courier New', monospace;
      }

      small {
        color: #6b7280;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
